{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional game snapshot field assertion",
  "type": "object",
  "required": ["type", "rootName", "path"],
  "properties": {
    "type": {"const": "game_state_field"},
    "step": {"type": "integer", "minimum": 0},
    "viewerPlayerID": {"type": "integer"},
    "rootName": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
    "path": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer", "minimum": 0}]}
    },
    "comparison": {"enum": ["equals", "missing_or_null"], "default": "equals"},
    "valueJson": {"type": "string", "description": "Required only for equals; must contain valid JSON. Stored as text to preserve JSON types through associative loaders."}
  },
  "allOf": [{
    "if": {"required": ["comparison"], "properties": {"comparison": {"const": "missing_or_null"}}},
    "then": {"not": {"required": ["valueJson"]}},
    "else": {"required": ["valueJson"]}
  }],
  "additionalProperties": false
}
