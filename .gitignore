# Scratch fixture dir written by Core/Match framework tests (test_match_core / test_match_flow)
MatchTestSim/
MatchFlowTestSim4/
# Card art is generated or downloaded, so these dirs are ignored — EXCEPT mock_* (preview) art,
# which is TRACKED: a previewed card's art often has no fetchable URL (upstream 404s until
# release), so unlike official art it cannot be re-downloaded on deploy.
# NOTE the "/*" on each dir. Ignoring the DIRECTORY itself ("SWUSim/concat") makes git skip
# walking into it, and per gitignore(5) "it is not possible to re-include a file if a parent
# directory of that file is excluded" — the ! lines would silently never apply.
# Extensions differ per dir: concat/ and WebpImages/ hold .webp; crops/ holds <id>_cropped.png.
SWUSim/concat/*
!SWUSim/concat/mock_*.webp
SWUSim/crops/*
!SWUSim/crops/mock_*.png
SWUSim/Games
SWUSim/Matches
SWUSim/GeneratedCode
SWUSim/TempImages
SWUSim/WebpImages/*
!SWUSim/WebpImages/mock_*.webp
SWUSim/GamestateParser.php
SWUSim/GeneratedUI*.js
SWUSim/GetNextTurn.php
SWUSim/InitialLayout.php
SWUSim/NextTurnRender.php
SWUSim/ZoneAccessors.php
SWUSim/ZoneClasses.php
SWUSim/TurnStates.php
SWUSim/TurnController.php
# Mirror of the mock_ preview art of PLAYABLE preview cards, derived by
# SWUSim/DevTools/sync-preview-images.php from the TRACKED WebpImages/mock_*.webp. Pure duplication of
# bytes already in git, and it grows with every preview, so it is generated rather than committed —
# re-run the sync after deploy (see the swusim-sync-preview-images skill) or the Previews page is empty.
SWUSim/PreviewsImplemented/
SWUSim/Tests/Snapshots/
SWUSim/docs/test-gaps/
