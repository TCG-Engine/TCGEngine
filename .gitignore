# --- AzukiDeck
*/Games
**/GeneratedCode
*/GamestateParser.php
*/GeneratedUI*.js
*/GetNextTurn.php
*/InitialLayout.php
*/NextTurnRender.php
*/ZoneAccessors.php
*/ZoneClasses.php
# "/*" rather than the bare dir: SWUDeck/WebpImages/ re-includes two shim files, and git cannot
# re-include a file whose parent DIRECTORY is excluded.
*/WebpImages/*
# ...except the Discord legacy-URL shim, which must ship. These sit BELOW the catch-all on purpose:
# gitignore takes the LAST matching pattern, so re-including them next to SWUDeck's other rules
# above would be undone by the line directly above this one.
!SWUDeck/WebpImages/index.php
!SWUDeck/WebpImages/.htaccess
*/crops
*/concat

# Shared SWU card art (AppCore/SWU/Images/). The rules above contain a slash, so git anchors them to
# the repo root and "*" matches exactly ONE path component — "*/WebpImages" matches SWUSim/WebpImages
# but NOT AppCore/SWU/Images/WebpImages. Without these, the first generation run stages ~470MB.
#
# The "dir/*" form is load-bearing: git cannot re-include a file with "!" once its PARENT DIRECTORY
# is excluded, so the bare-directory form used above would silently swallow the mock exceptions
# below. Verified empirically 2026-08-04.
AppCore/SWU/Images/WebpImages/*
AppCore/SWU/Images/concat/*
AppCore/SWU/Images/crops/*
AppCore/SWU/Images/TempImages
# ...except preview mock art, which is TRACKED SOURCE: it ships to boxes that never call the
# upstream API, so it cannot be regenerated there.
!AppCore/SWU/Images/WebpImages/mock_*
!AppCore/SWU/Images/concat/mock_*
!AppCore/SWU/Images/crops/mock_*
# SET_NNN migration SQL is GENERATED per box (tools/materialize-id-map.php, tools/build-rekey-sql.php)
# and encodes one box's card dictionary and schema at one moment. Committing it guarantees someone
# eventually applies a stale map. The generators are tracked; their output is not.
AppCore/SWU/migrations/0*.sql

# Maintenance-mode flag (zzMaintenanceMode.php). Runtime operational state, per box — its ABSENCE
# means "normal service", so it must never ship in a deploy and freeze a healthy site.
*/maintenance.json
